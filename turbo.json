{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".npmrc",
    "pnpm-lock.yaml"
  ],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "AUTH_DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "DATABASE_URL",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "NEXT_PUBLIC_BASE_URL",
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SANITY_DATASET",
        "NEXT_PUBLIC_RECAPTCHA_SITE_KEY"
      ]
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "type-check:baseline": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "inputs": [
        "src/**",
        ".quality-baseline/**",
        "tsconfig.json"
      ]
    },
    "lint": {
      "outputs": []
    },
    "lint:baseline": {
      "outputs": [],
      "inputs": [
        "src/**",
        ".quality-baseline/**",
        "eslint.config.mjs"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "quality": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
