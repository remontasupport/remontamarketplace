# pnpm configuration.
#
# This replaced `legacy-peer-deps=true`, which was an npm-only setting and has
# no pnpm equivalent. It was there for exactly one conflict:
#
#   nodemailer@6.10.1 installed
#   @auth/core@0.41.1 requires peer nodemailer@7.0.13
#
# That resolves itself in U13, which retires Nodemailer in favour of Resend
# (AD-02). Until then pnpm warns rather than fails, because
# strict-peer-dependencies defaults to false.
#
# node-linker is deliberately NOT set to `hoisted`. The isolated default is the
# whole reason pnpm was chosen (D-08): it turns an undeclared dependency into a
# build error instead of an accident that works until it does not. Hoisting
# would give us pnpm's speed and none of its safety. If something fails to
# resolve, declare the dependency -- do not loosen the linker.

# Peer conflicts warn instead of failing. Revisit after U13.
strict-peer-dependencies=false

# Install peers automatically, matching what npm did.
auto-install-peers=true

# node-linker: Prisma resolves its query engine through node_modules/.prisma and
# node_modules/@prisma/client, and vercel.json's includeFiles globs both paths.
# pnpm's isolated linker makes .prisma nonexistent at the root and @prisma/client
# a symlink into .pnpm, so the rhel-openssl-3.0.x engine Vercel needs is not
# reachable through either glob. Verified by clean install: with isolation the
# engine sits at node_modules/.pnpm/@prisma+client@<hash>/node_modules/.prisma/;
# with hoisted it sits at node_modules/.prisma/ where the glob finds it.
#
# TRADE-OFF, recorded honestly: this reverses D4=A. Hoisting restores npm-like
# flat resolution, so a future undeclared dependency will silently work again
# rather than failing the build. The two phantoms U5 found are already declared,
# so nothing regresses today -- but the guard against NEW ones is weakened.
# public-hoist-pattern[]=*prisma* was tried first and does NOT help: @prisma/client
# is a direct dependency, which pnpm links at the root regardless of hoist patterns.
#
# U8 removes the need for this entirely by giving the main schema an explicit
# output under src/generated, as auth-schema.prisma already does -- at which point
# no node_modules path is involved and this line should be deleted.
node-linker=hoisted
