# pnpm configuration.
#
# This replaced `legacy-peer-deps=true`, which was an npm-only setting and has
# no pnpm equivalent. It was there for exactly one conflict:
#
#   nodemailer@6.10.1 installed
#   @auth/core@0.41.1 requires peer nodemailer@7.0.13
#
# That resolves itself in U13, which retires Nodemailer in favour of Resend
# (AD-02). Until then pnpm warns rather than fails, because
# strict-peer-dependencies defaults to false.
#
# node-linker is deliberately NOT set to `hoisted`. The isolated default is the
# whole reason pnpm was chosen (D-08): it turns an undeclared dependency into a
# build error instead of an accident that works until it does not. Hoisting
# would give us pnpm's speed and none of its safety. If something fails to
# resolve, declare the dependency -- do not loosen the linker.

# Peer conflicts warn instead of failing. Revisit after U13.
strict-peer-dependencies=false

# Install peers automatically, matching what npm did.
auto-install-peers=true

# node-linker: set to `hoisted`, reversing the paragraph above and decision D4=A.
#
# Established by five preview deployments on 2026-09-22 (see
# aidlc-docs/construction/U5/code/U5-summary.md, Addendum): pnpm's isolated
# layout cannot deploy on Vercel. Every isolated-linker branch failed with an
# "internal Vercel error" and an empty build log, while local builds succeeded in
# every configuration. The linker was the only variable that changed the outcome;
# the root cause inside Vercel is NOT established.
#
# This is a workspace-wide setting, so it now covers BOTH apps. That incidentally
# resolves the open marketing question -- apps/web had no .npmrc and would have
# run the isolated linker alone.
#
# Cost: phantom-dependency detection is gone. pnpm caught two undeclared
# dependencies during U5, one of them live newsroom-rendering code on the
# marketing side. Both are declared now, so nothing regresses -- but new ones
# will pass silently, and U7 extracts packages, which is when they appear.
#
# Remove once the Vercel failure is understood rather than guessed. Tracked for U8.
node-linker=hoisted
