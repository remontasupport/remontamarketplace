# pnpm configuration.
#
# This replaced `legacy-peer-deps=true`, which was an npm-only setting and has
# no pnpm equivalent. It was there for exactly one conflict:
#
#   nodemailer@6.10.1 installed
#   @auth/core@0.41.1 requires peer nodemailer@7.0.13
#
# That resolves itself in U13, which retires Nodemailer in favour of Resend
# (AD-02). Until then pnpm warns rather than fails, because
# strict-peer-dependencies defaults to false.
#
# node-linker is deliberately NOT set to `hoisted`. The isolated default is the
# whole reason pnpm was chosen (D-08): it turns an undeclared dependency into a
# build error instead of an accident that works until it does not. Hoisting
# would give us pnpm's speed and none of its safety. If something fails to
# resolve, declare the dependency -- do not loosen the linker.

# Peer conflicts warn instead of failing. Revisit after U13.
strict-peer-dependencies=false

# Install peers automatically, matching what npm did.
auto-install-peers=true

# node-linker: set to `hoisted`, reversing the paragraph above. That paragraph
# stated the intent (D4=A) correctly; it is kept as written because the reason it
# gave is still the reason to remove this line as soon as possible.
#
# WHY IT WAS NECESSARY, from five preview deployments in U5:
#
#   branch            vercel.json            linker     prisma output    result
#   ----------------  ---------------------  ---------  ---------------  ------
#   u5-pnpm           original (3 globs)     isolated   node_modules     FAIL
#   u5-test-nomono    original               isolated   node_modules     FAIL
#   u5-test-nofn      src/generated/**       isolated   node_modules     FAIL
#   u5-fix-output     src/generated/**       isolated   src/generated    FAIL
#   u5-fix-hoisted    original               hoisted    node_modules     PASS
#
# Every isolated-linker branch failed with "internal Vercel error" and an empty
# build log. The linker is the only variable that changed the outcome. Note that
# u5-fix-output moved the Prisma client into the source tree and STILL failed --
# so this is not, as first supposed, only about Prisma's engine paths. The root
# cause inside Vercel is not established; what is established is the boundary.
#
# COST, stated plainly: hoisting restores npm-like flat resolution, so an
# undeclared dependency silently works again instead of failing the build. U5
# caught two phantom dependencies this way on its first attempt, one of them live
# code rendering newsroom articles. That guard is gone while this line is here --
# including through U6 and U7, which move code between package boundaries and are
# exactly when phantom dependencies appear. Treat any dependency error during
# those units with extra suspicion, since pnpm will no longer raise it for you.
#
# TO REMOVE: needs the actual Vercel build failure understood, not guessed. The
# next step is Vercel support or a support ticket with the failing deployment IDs,
# since the build log is empty and local reproduction succeeds. Tracked for U8.
node-linker=hoisted
