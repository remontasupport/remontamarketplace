// ============================================================================
// W1 — JSON promotion. Added 2026-09-06.
//
// These four tables are populated by the W1 backfill from the Json columns on
// worker_additional_info. Those columns REMAIN until W1 reaches phase P7, so
// both shapes coexist during dual-write. Nothing reads these tables until the
// read switch is flipped.
//
// Design: aidlc-docs/inception/application-design/target-schema.md
// ============================================================================

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// The five care domains found in WorkerAdditionalInfo.experience.
enum CareDomain {
  DISABILITY
  AGED_CARE
  WORKING_WITH_CHILDREN
  MENTAL_HEALTH
  CHRONIC_MEDICAL
}

/// From jobHistory Json — 7 uniform keys.
model WorkerJobHistory {
  id               String  @id @default(cuid())
  workerProfileId  String
  jobTitle         String
  company          String
  startMonth       String?
  startYear        Int?
  endMonth         String?
  endYear          Int?
  currentlyWorking Boolean @default(false)
  sortOrder        Int     @default(0) // preserves array order

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId])
  @@map("worker_job_history")
}

/// From education Json — 7 uniform keys.
model WorkerEducation {
  id                String  @id @default(cuid())
  workerProfileId   String
  institution       String
  qualification     String
  startMonth        String?
  startYear         Int?
  endMonth          String?
  endYear           Int?
  currentlyStudying Boolean @default(false)
  sortOrder         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId])
  @@map("worker_education")
}

/// From availability Json, which is keyed by weekday. A day holds either one
/// {startTime,endTime} object or an array of them; one row per slot handles both.
///
/// Minutes from midnight (0-1439) rather than "HH:MM" strings: sortable,
/// comparable, and endMinute <= startMinute expresses an overnight shift, which
/// a lexical string compare cannot. Times are local to the worker; no zone is
/// stored — derive it from state if scheduling ever needs one.
model WorkerAvailability {
  id              String    @id @default(cuid())
  workerProfileId String
  dayOfWeek       DayOfWeek
  startMinute     Int
  endMinute       Int
  sortOrder       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  // Unique on start AND end, not start alone. Rehearsal against production data
  // found real days holding two slots that share a start: Saturday 00:00-07:00
  // alongside 00:00-23:00. Keying on start alone would have discarded one, and
  // which one survived would have depended on JSON key order.
  // This still collapses true duplicates — the same day, start and end twice.
  @@unique([workerProfileId, dayOfWeek, startMinute, endMinute])
  @@index([workerProfileId])
  @@index([dayOfWeek])
  @@map("worker_availability")
}

/// From experience Json — object keyed by 5 care domains, each with 5 keys.
/// Makes "professional mental-health experience" an indexed query.
model WorkerExperience {
  id              String     @id @default(cuid())
  workerProfileId String
  domain          CareDomain

  isProfessional Boolean  @default(false)
  isPersonal     Boolean  @default(false)
  specificAreas  String[] @default([])
  otherAreas     String[] @default([])
  description    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, domain])
  @@index([domain])
  @@map("worker_experience")
}

// ---------------------------------------------------------------------------
// S1 — Worker registration slice. Design: aidlc-docs/construction/S1-registration/
//
// Written by hand in the migrations, because Prisma cannot express them — do not
// let a generated migration drop them:
//   * `point` columns are GENERATED ALWAYS from latitude/longitude (PostGIS).
//     Never write them; Prisma cannot, because they are Unsupported.
//   * worker_locations_one_home_per_worker — partial unique index (one HOME row).
//   * CHECK constraints on worker_locations and au_localities.
// ---------------------------------------------------------------------------

/// One row per Australian suburb–postcode pair, from Geoscape G-NAF
/// (packages/db/data/au_localities.csv). Rows are never deleted: a locality
/// dropped by a release is retired, so worker locations that point at it stay valid.
model AuLocality {
  id             Int                                    @id @default(autoincrement())
  /// G-NAF LOCALITY.LOCALITY_PID ("loc…" or a legacy number) -- the key LOCALITY_POINT
  /// joins on. NOT G-NAF's GNAF_LOCALITY_PID column, which is often empty.
  localityPid    String
  suburb         String
  /// Lower-case, single-spaced suburb name; what the search box matches on.
  searchName     String
  state          String
  postcode       String
  latitude       Float
  longitude      Float
  point          Unsupported("geography(Point, 4326)")?
  sourceVersion  String
  retiredAt      DateTime?
  supersededById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supersededBy    AuLocality?      @relation("LocalitySuccession", fields: [supersededById], references: [id])
  supersedes      AuLocality[]     @relation("LocalitySuccession")
  workerLocations WorkerLocation[]

  @@unique([localityPid, postcode])
  @@index([searchName])
  @@index([postcode])
  @@index([point], type: Gist)
  @@map("au_localities")
}

/// One row per applied localities:refresh run -- the audit trail for au_localities.
/// A dry run writes nothing; an --apply with nothing to change writes nothing.
model AuLocalityRefresh {
  id            Int      @id @default(autoincrement())
  sourceVersion String
  /// planHash() of what was applied; matches the --expect value that was reviewed.
  planHash      String
  inserted      Int
  updated       Int
  restored      Int
  retired       Int
  unchanged     Int
  /// Keys of every changed row, and the workers placed at each retired one.
  details       Json
  appliedBy     String
  appliedAt     DateTime @default(now())

  @@map("au_locality_refreshes")
}

/// Where a worker is. Exactly one HOME row per worker (partial unique index,
/// hand-written), carrying the travel radius. SERVICE_AREA is reserved: option A
/// (radius only) was chosen on 2026-09-25, so nothing writes it yet.
model WorkerLocation {
  id              String                                 @id @default(cuid())
  workerProfileId String
  kind            LocationKind
  localityId      Int
  latitude        Float
  longitude       Float
  point           Unsupported("geography(Point, 4326)")?
  travelRadiusKm  Int?
  precision       LocationPrecision
  source          LocationSource

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  locality      AuLocality    @relation(fields: [localityId], references: [id], onDelete: Restrict)

  @@index([workerProfileId])
  @@index([localityId])
  @@index([point], type: Gist)
  @@map("worker_locations")
}

/// The onboarding marker: one row per worker. `stage` is derived by deriveStage()
/// in apps/api and is never set by a client.
model WorkerOnboarding {
  workerProfileId      String          @id
  stage                OnboardingStage
  stageEnteredAt       DateTime
  signedUpAt           DateTime
  firstSignInAt        DateTime?
  firstDocumentAt      DateTime?
  documentsSubmittedAt DateTime?
  verifiedAt           DateTime?
  publishedAt          DateTime?
  lastActivityAt       DateTime
  mandatoryTotal       Int             @default(0)
  mandatoryUploaded    Int             @default(0)
  mandatoryApproved    Int             @default(0)
  catalogueVersion     Int             @default(0)
  /// Optimistic lock.
  version              Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([stage, stageEnteredAt])
  @@index([stage, lastActivityAt])
  @@map("worker_onboarding")
}

/// Append-only history of stage changes. Rows are never updated or deleted.
/// Scheduled jobs (onboarding reconciler, photo purge): the lease that makes only
/// one instance run a job, its last run, and the reconciler's watermark.
model ScheduledJob {
  name           String    @id
  lockedUntil    DateTime?
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastResult     Json?
  watermark      DateTime?

  @@map("scheduled_jobs")
}

model WorkerOnboardingTransition {
  id              BigInt                     @id @default(autoincrement())
  workerProfileId String
  fromStage       OnboardingStage?
  toStage         OnboardingStage
  at              DateTime                   @default(now())
  cause           String
  actorId         String?
  source          OnboardingTransitionSource

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId, at])
  @@index([toStage, at])
  @@map("worker_onboarding_transitions")
}

/// Transactional outbox: written in the same transaction as the business change,
/// delivered by the apps/api dispatcher. Handlers are idempotent on `id`.
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  type          String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  /// Claim lease: a crashed dispatcher's claim expires and the event is retried.
  lockedUntil   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  @@index([status, nextAttemptAt])
  @@index([type, createdAt])
  @@map("outbox_events")
}

/// A photo uploaded during sign-up, before the account exists. The registration
/// request references it by id and claims it once; unclaimed rows are purged after 24 h.
model RegistrationPhotoUpload {
  id                       String    @id @default(uuid()) @db.Uuid
  blobKey                  String    @unique
  /// The public URL the store returned; copied to worker_profiles.photos on claim.
  url                      String
  contentType              String
  sizeBytes                Int
  ipHash                   String
  createdAt                DateTime  @default(now())
  claimedAt                DateTime?
  claimedByWorkerProfileId String?

  claimedBy WorkerProfile? @relation(fields: [claimedByWorkerProfileId], references: [id], onDelete: SetNull)

  @@index([claimedAt, createdAt])
  @@map("registration_photo_uploads")
}

/// Fixed-window rate-limit counters for apps/api, until a Redis decision (OI-08).
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

enum OnboardingStage {
  SIGNED_UP
  DOCUMENTS_IN_PROGRESS
  DOCUMENTS_SUBMITTED
  ACTION_REQUIRED
  VERIFIED
  PUBLISHED
}

enum OnboardingTransitionSource {
  API
  RECONCILER
  BACKFILL
}

enum LocationKind {
  HOME
  SERVICE_AREA
}

enum LocationPrecision {
  LOCALITY
  ADDRESS
}

enum LocationSource {
  REGISTRATION
  ONBOARDING
  ADMIN
  RECONCILER
  BACKFILL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  DEAD
}
