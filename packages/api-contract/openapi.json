    "/v1/registrations/worker/email-codes/verify": {
      "post": {
        "operationId": "registration.verifyEmailCode",
        "summary": "Check a code against its ticket. The code expires 10 minutes after it was sent.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "expiresAt": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 320
                  },
                  "code": {
                    "type": "string",
                    "maxLength": 32
                  }
                },
                "required": [
                  "token",
                  "expiresAt",
                  "email",
                  "code"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
