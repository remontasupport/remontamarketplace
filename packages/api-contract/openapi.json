{
  "openapi": "3.1.0",
  "info": {
    "title": "Remonta API",
    "version": "1"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "platform.health",
        "summary": "Liveness: the process is up and its database answers.",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-remonta-security": {
          "access": "public",
          "bot": "none",
          "rateLimit": [
            {
              "per": "ip",
              "limit": 60,
              "window": "1m"
            }
          ],
          "maxBodyKb": 1,
          "loadShedding": "exempt"
        }
      }
    },
    "/v1/localities": {
      "get": {
        "operationId": "registration.searchLocalities",
        "summary": "Suburb autocomplete for sign-up: prefix match on suburb or postcode, current rows only, at most 10.",
        "security": [],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "localities": {
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "suburb": {
                            "type": "string"
                          },
                          "state": {
                            "type": "string",
                            "enum": [
                              "NSW",
                              "VIC",
                              "QLD",
                              "WA",
                              "SA",
                              "TAS",
                              "ACT",
                              "NT",
                              "OT"
                            ]
                          },
                          "postcode": {
                            "type": "string",
                            "pattern": "^[0-9]{4}$"
                          },
                          "label": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "suburb",
                          "state",
                          "postcode",
                          "label"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "localities"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-remonta-security": {
          "access": "public",
          "bot": "none",
          "rateLimit": [
            {
              "per": "ip",
              "limit": 120,
              "window": "1m"
            },
            {
              "per": "global",
              "limit": 6000,
              "window": "1m"
            }
          ],
          "maxBodyKb": 1,
          "cacheSeconds": 3600
        }
      }
    },
    "/v1/registrations/worker/photo": {
      "post": {
        "operationId": "registration.uploadRegistrationPhoto",
        "summary": "Stage a profile photo for a sign-up. Returns an upload id, never a URL.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "photo"
                ],
                "properties": {
                  "photo": {
                    "type": "string",
                    "contentMediaType": "application/octet-stream"
                  }
                }
              },
              "encoding": {
                "photo": {
                  "contentType": "image/jpeg, image/png, image/webp, image/heic"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "photoUploadId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "required": [
                    "photoUploadId"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_MEDIA_TYPE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-remonta-security": {
          "access": "public",
          "bot": "none",
          "rateLimit": [
            {
              "per": "ip",
              "limit": 10,
              "window": "1h"
            },
            {
              "per": "global",
              "limit": 300,
              "window": "1h"
            }
          ],
          "maxBodyKb": 5120
        }
      }
    },
    "/v1/registrations/worker": {
      "post": {
        "operationId": "registration.submitWorkerRegistration",
        "summary": "Create a worker account. The same 202 for a new and an existing email.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "localityId": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "firstName": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "lastName": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 320
                  },
                  "mobile": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128
                  },
                  "services": {
                    "minItems": 1,
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "supportWorkerCategories": {
                    "maxItems": 30,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "photoUploadId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "consentProfileShare": {
                    "type": "boolean",
                    "const": true
                  },
                  "consentWordingVersion": {
                    "type": "string",
                    "const": "worker-profile-share-v1"
                  },
                  "zohoLeadId": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "captchaToken": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "localityId",
                  "firstName",
                  "lastName",
                  "email",
                  "mobile",
                  "password",
                  "services",
                  "photoUploadId",
                  "consentProfileShare",
                  "consentWordingVersion",
                  "captchaToken"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "accepted"
                    },
                    "message": {
                      "type": "string",
                      "const": "Check your inbox — if this email is new, your account is ready and you can sign in now."
                    }
                  },
                  "required": [
                    "status",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-remonta-security": {
          "access": "public",
          "bot": {
            "captcha": {
              "action": "worker_register"
            }
          },
          "rateLimit": [
            {
              "per": "ip",
              "limit": 5,
              "window": "1h"
            },
            {
              "per": "global",
              "limit": 500,
              "window": "1h"
            }
          ],
          "maxBodyKb": 16,
          "audit": "ACCOUNT_REGISTERED"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_REQUEST",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "PAYLOAD_TOO_LARGE",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "RATE_LIMITED",
                  "INTERNAL",
                  "UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "session": []
    }
  ]
}
