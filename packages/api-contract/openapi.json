    "/v1/localities": {
      "get": {
        "operationId": "registration.searchLocalities",
        "summary": "Suburb autocomplete for sign-up: prefix match on suburb or postcode, current rows only, at most 10.",
        "security": [],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "localities": {
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "suburb": {
                            "type": "string"
                          },
                          "state": {
                            "type": "string",
                            "enum": [
                              "NSW",
                              "VIC",
                              "QLD",
                              "WA",
                              "SA",
                              "TAS",
                              "ACT",
                              "NT",
                              "OT"
                            ]
                          },
                          "postcode": {
                            "type": "string",
                            "pattern": "^[0-9]{4}$"
                          },
                          "label": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "suburb",
                          "state",
                          "postcode",
                          "label"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "localities"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-remonta-security": {
          "access": "public",
          "bot": "none",
          "rateLimit": [
            {
              "per": "ip",
              "limit": 120,
              "window": "1m"
            },
            {
              "per": "global",
              "limit": 6000,
              "window": "1m"
            }
          ],
          "maxBodyKb": 1,
          "cacheSeconds": 3600
        }
      }
    },
    "/v1/registrations/worker/photo": {
      "post": {
        "operationId": "registration.uploadRegistrationPhoto",
        "summary": "Stage a profile photo for a sign-up. Returns an upload id, never a URL.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "photo"
                ],
                "properties": {
                  "photo": {
                    "type": "string",
                    "contentMediaType": "application/octet-stream"
                  }
                }
              },
              "encoding": {
                "photo": {
                  "contentType": "image/jpeg, image/png, image/webp, image/heic"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "photoUploadId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "required": [
                    "photoUploadId"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE",
