{
  "displayName": "__SERVICE__ outbox-dead-letter",
  "documentation": {
    "content": "An outbox event of __SERVICE__ (__STAGE__) exhausted its retries: an email or CRM notification will never be delivered on its own. Look at `SELECT * FROM outbox_events WHERE status = 'DEAD'` on that stage's database and at the log line with alert=\"outbox-dead-letter\" (it carries outboxEventId and type).",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "dead letters in 5 minutes >= 1",
      "conditionThreshold": {
        "filter": "resource.type = \"cloud_run_revision\" AND resource.labels.service_name = \"__SERVICE__\" AND metric.type = \"logging.googleapis.com/user/remonta-api-outbox-dead-letter\"",
        "aggregations": [{ "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["resource.labels.service_name"] }],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "0s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "notificationChannels": ["__CHANNEL__"],
  "alertStrategy": { "autoClose": "3600s" },
  "severity": "ERROR",
  "userLabels": { "remonta-stage": "__STAGE__", "remonta-service": "api" }
}
