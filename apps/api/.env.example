# apps/api environment. Copy to .env (gitignored) and fill in. The service refuses
# to start if any required variable is missing or malformed.
NODE_ENV=development
PORT=4000
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/s1test
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/s1test
# Comma-separated origins allowed by CORS: the apps/app URLs. No wildcard.
CORS_ORIGINS=http://localhost:3000
# reCAPTCHA v3
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost
RECAPTCHA_MIN_SCORE=0.5
RESEND_API_KEY=
N8N_REGISTRATION_WEBHOOK_URL=
N8N_WEBHOOK_URL=
