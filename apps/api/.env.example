# apps/api environment. Copy to .env (gitignored) and fill in. The service refuses
# to start if any required variable is missing or malformed.
NODE_ENV=development
PORT=4000
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/s1test
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/s1test
# Comma-separated origins allowed by CORS: the apps/app URLs. No wildcard.
CORS_ORIGINS=http://localhost:3000
# reCAPTCHA v3
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost
RECAPTCHA_MIN_SCORE=0.5
RESEND_API_KEY=
N8N_REGISTRATION_WEBHOOK_URL=
IP_HASH_SECRET=
# The api token (U1): the same value as apps/app's API_TOKEN_SECRET for this stage, 32+ characters.
# API_TOKEN_SECRET_PREVIOUS is only set during a secret rotation (infra/README.md).
API_TOKEN_SECRET=
API_TOKEN_SECRET_PREVIOUS=
# Sign-up photos (U3): the browser uploads to a private Cloud Storage bucket; the clean copies live in
# Vercel Blob. Locally and in CI a fake server stands in for the bucket:
#   docker run -d --name remonta-s1-gcs -p 4443:4443 fsouza/fake-gcs-server:1.52.2 -scheme http -public-host localhost:4443
PHOTO_BUCKET=test-photos
PHOTO_PUBLIC_BASE_URL=http://localhost:4443/test-photos
GCS_API_ENDPOINT=http://localhost:4443
# Vercel Blob read-write token: where every photo lives and is served from. Required.
BLOB_READ_WRITE_TOKEN=
EMAIL_FROM=Remonta <community@remontaservices.com.au>
APP_BASE_URL=http://localhost:3000
RECONCILER_INTERVAL_MS=300000
